{#- Per-VRF "vrf context" stanzas (NX-OS).                                      -#}
{#- ISOLATION: each VRF gets a unique RD and an ipv4 address-family, but NO      -#}
{#- route-target import/export and NO import/export route-maps are emitted.     -#}
{#- That is what guarantees the two VRFs never exchange routes.                  -#}
!
! ===== VRF contexts (fully isolated — no route-target import/export) =====
{% for vrf in vrfs %}
vrf context {{ vrf.name }}
  description {{ vrf.description }}
  rd {{ vrf.rd }}
  address-family ipv4 unicast
{% endfor %}
