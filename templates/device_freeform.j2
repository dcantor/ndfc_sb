{#- =========================================================================== -#}
{#- Per-device freeform CLI for one core router. Rendered once per device and    -#}
{#- pushed as a switch_freeform policy (playbooks/02_config.yml).                 -#}
{#- Everything is derived from vars/topology.yml + vars/vrfs.yml + vars/bgp.yml.  -#}
{#-                                                                               -#}
{#- Context: dev (this device name), devices, datacenters, links, vrfs, bfd, mtu  -#}
{#- =========================================================================== -#}
{%- set me = devices[dev] -%}
{%- set my_dc = me.dc -%}
{%- set my_asn = datacenters[my_dc].asn -%}
{#- Orient every link that touches this device into a "my side / peer side" view -#}
{%- set ns = namespace(links=[], intra_peers=[]) -%}
{%- for link in links if link.a == dev or link.b == dev -%}
{%-   if link.a == dev -%}
{%-     set o = {'type': link.type, 'my_intf': link.a_intf, 'my_ip': link.a_ip,
                 'peer': link.b, 'peer_ip': link.b_ip, 'mask': link.mask,
                 'subifs': link.subifs, 'side': 'a'} -%}
{%-   else -%}
{%-     set o = {'type': link.type, 'my_intf': link.b_intf, 'my_ip': link.b_ip,
                 'peer': link.a, 'peer_ip': link.a_ip, 'mask': link.mask,
                 'subifs': link.subifs, 'side': 'b'} -%}
{%-   endif -%}
{%-   set ns.links = ns.links + [o] -%}
{%-   if o.type == 'intra' and o.peer not in ns.intra_peers -%}{%- set ns.intra_peers = ns.intra_peers + [o.peer] -%}{%- endif -%}
{%- endfor -%}
!
! ##########################################################################
! # {{ dev }}  (DC {{ my_dc }}, AS {{ my_asn }})  — generated, do not hand-edit
! ##########################################################################
!
feature bgp
feature bfd
feature ospf
!
! ===== Interfaces =====
interface loopback0
  description router-id / intra-DC iBGP source
  ip address {{ me.lo0 }}/32
  ip router ospf {{ ospf.process }} area {{ ospf.area }}
{% for vrf in vrfs %}
interface loopback{{ vrf.loopback_id }}
  description {{ vrf.name }} BGP source
  vrf member {{ vrf.name }}
  ip address {{ me.vrf_lo[vrf.name] }}/32
  ip router ospf {{ ospf.process }} area {{ ospf.area }}
{% endfor %}
{% for o in ns.links %}
interface {{ o.my_intf }}
  description {{ o.type }} link to {{ o.peer }}
  no switchport
  mtu {{ mtu }}
  ip address {{ o.my_ip }}/{{ o.mask }}
  bfd interval {{ bfd.interval }} min_rx {{ bfd.min_rx }} multiplier {{ bfd.multiplier }}
{%-  if o.type == 'intra' %}
  ip router ospf {{ ospf.process }} area {{ ospf.area }}
  ip ospf network point-to-point
  ip ospf bfd
{%-  endif %}
  no shutdown
{%   for vrf in vrfs %}
{%-    set su = o.subifs[vrf.name] %}
{%-    set my_su_ip = su.a_ip if o.side == 'a' else su.b_ip %}
interface {{ o.my_intf }}.{{ su.dot1q }}
  description {{ vrf.name }} {{ o.type }} hand-off to {{ o.peer }}
  encapsulation dot1q {{ su.dot1q }}
  vrf member {{ vrf.name }}
  ip address {{ my_su_ip }}/{{ su.mask }}
  bfd interval {{ bfd.interval }} min_rx {{ bfd.min_rx }} multiplier {{ bfd.multiplier }}
{%-    if o.type == 'intra' %}
  ip router ospf {{ ospf.process }} area {{ ospf.area }}
  ip ospf network point-to-point
  ip ospf bfd
{%-    endif %}
  no shutdown
{%   endfor %}
{% endfor %}
{% for dl in downstream_links | default([]) if dl.core == dev %}
interface {{ dl.core_intf }}
  description downstream link to {{ dl.ds_name }}
  no switchport
  mtu {{ mtu }}
  ip address {{ dl.core_ip }}/{{ dl.mask }}
  bfd interval {{ bfd.interval }} min_rx {{ bfd.min_rx }} multiplier {{ bfd.multiplier }}
  no shutdown
{%   for vrf in vrfs %}
{%-    set su = dl.subifs[vrf.name] %}
interface {{ dl.core_intf }}.{{ su.dot1q }}
  description {{ vrf.name }} downstream hand-off to {{ dl.ds_name }}
  encapsulation dot1q {{ su.dot1q }}
  vrf member {{ vrf.name }}
  ip address {{ su.core_ip }}/{{ su.mask }}
  bfd interval {{ bfd.interval }} min_rx {{ bfd.min_rx }} multiplier {{ bfd.multiplier }}
  no shutdown
{%   endfor %}
{% endfor %}
!
! ===== VRF contexts (fully isolated — NO route-target import/export) =====
{% for vrf in vrfs %}
vrf context {{ vrf.name }}
  description {{ vrf.description }}
  rd {{ my_asn }}:{{ vrf.rd_index }}
  address-family ipv4 unicast
{% endfor %}
!
! ===== OSPF — intra-DC IGP for iBGP loopback reachability (global + per-VRF) =====
! Runs only on intra-DC links (ECMP over the 2 links); BFD-enabled (ip ospf bfd).
router ospf {{ ospf.process }}
  router-id {{ me.lo0 }}
{% for vrf in vrfs %}
  vrf {{ vrf.name }}
    router-id {{ me.vrf_lo[vrf.name] }}
{% endfor %}
!
! No static routes: intra-DC loopback reachability is via OSPF; inter-DC eBGP
! peers on the directly-connected DCI addresses.
!
! ===== BGP =====
router bgp {{ my_asn }}
  router-id {{ me.lo0 }}
  log-neighbor-changes
  address-family ipv4 unicast
    network {{ me.lo0 }}/32
{% for peer in ns.intra_peers %}
  ! iBGP (intra-DC) to {{ peer }} — loopback peering (reachable via OSPF)
  neighbor {{ devices[peer].lo0 }}
    remote-as {{ my_asn }}
    description iBGP-to-{{ peer }}
    update-source loopback0
    bfd
    address-family ipv4 unicast
      next-hop-self
{% endfor %}
{% for o in ns.links if o.type == 'inter' %}
  ! eBGP (inter-DC) to {{ o.peer }} — directly-connected DCI address (single-hop)
  neighbor {{ o.peer_ip }}
    remote-as {{ datacenters[devices[o.peer].dc].asn }}
    description eBGP-to-{{ o.peer }}
    bfd
    address-family ipv4 unicast
{% endfor %}
{% for dl in downstream_links | default([]) if dl.core == dev %}
  ! eBGP (downstream) to {{ dl.ds_name }} — directly-connected, single-hop
  neighbor {{ dl.ds_ip }}
    remote-as {{ dl.ds_asn }}
    description eBGP-to-{{ dl.ds_name }}
    bfd
    address-family ipv4 unicast
{% endfor %}
{% for vrf in vrfs %}
  ! ----- {{ vrf.name }} -----
  vrf {{ vrf.name }}
    router-id {{ me.vrf_lo[vrf.name] }}
    address-family ipv4 unicast
      network {{ me.vrf_lo[vrf.name] }}/32
{%   for n in vrf.networks %}
      network {{ n }}
{%   endfor %}
{%   for peer in ns.intra_peers %}
    ! iBGP (intra-DC) {{ vrf.name }} to {{ peer }} — loopback peering (via OSPF)
    neighbor {{ devices[peer].vrf_lo[vrf.name] }}
      remote-as {{ my_asn }}
      description iBGP-{{ vrf.name }}-to-{{ peer }}
      update-source loopback{{ vrf.loopback_id }}
      bfd
      address-family ipv4 unicast
        next-hop-self
{%   endfor %}
{%   for o in ns.links if o.type == 'inter' %}
{%-    set su = o.subifs[vrf.name] %}
{%-    set peer_su_ip = su.b_ip if o.side == 'a' else su.a_ip %}
    ! eBGP (inter-DC) {{ vrf.name }} to {{ o.peer }} — directly-connected sub-int (single-hop)
    neighbor {{ peer_su_ip }}
      remote-as {{ datacenters[devices[o.peer].dc].asn }}
      description eBGP-{{ vrf.name }}-to-{{ o.peer }}
      bfd
      address-family ipv4 unicast
        route-map {{ vrf.route_maps.inbound }} in
        route-map {{ vrf.route_maps.outbound }} out
{%   endfor %}
{%   for dl in downstream_links | default([]) if dl.core == dev %}
{%-    set su = dl.subifs[vrf.name] %}
    ! eBGP (downstream) {{ vrf.name }} to {{ dl.ds_name }} — VRF-Lite hand-off (single-hop)
    neighbor {{ su.ds_ip }}
      remote-as {{ dl.ds_asn }}
      description eBGP-{{ vrf.name }}-to-{{ dl.ds_name }}
      bfd
      address-family ipv4 unicast
        route-map {{ vrf.route_maps.inbound }} in
        route-map {{ vrf.route_maps.outbound }} out
{%   endfor %}
{% endfor %}
