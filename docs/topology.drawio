        <!-- Downstream AS labels -->
        <mxCell id="ds1lbl" value="downstream DC core switches — AS 65011 (external)" style="text;html=1;align=center;fontSize=10;fontColor=#6a7c8c;" vertex="1" parent="1"><mxGeometry x="90" y="500" width="320" height="20" as="geometry"/></mxCell>
        <mxCell id="ds2lbl" value="downstream DC core switches — AS 65021 (external)" style="text;html=1;align=center;fontSize=10;fontColor=#6a7c8c;" vertex="1" parent="1"><mxGeometry x="650" y="500" width="320" height="20" as="geometry"/></mxCell>

        <!-- Title + note -->
        <mxCell id="title" value="Nexus 9000 DC Core — BGP + VRF Lite (no VXLAN/EVPN)" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1b2a3a;" vertex="1" parent="1"><mxGeometry x="270" y="14" width="560" height="30" as="geometry"/></mxCell>
        <mxCell id="note" value="All BGP neighbors BFD-enabled · loopback iBGP / link-address eBGP · VRF_A &amp; VRF_B fully isolated (no route-target import/export)" style="text;html=1;align=left;fontSize=11;fontColor=#6a7c8c;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="960" height="20" as="geometry"/></mxCell>
