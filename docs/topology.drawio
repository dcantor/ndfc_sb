<mxfile host="app.diagrams.net" type="device">
  <diagram id="ndfc-sb-topology" name="DC Core Topology">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- DC group boxes -->
        <mxCell id="dc1box" value="DATA CENTER 1 — core AS 65001" style="rounded=1;arcSize=6;fillColor=#eef5fb;strokeColor=#9cc0db;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#27506e;" vertex="1" parent="1">
